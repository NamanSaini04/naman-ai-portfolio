{
  "functions": {
    "api/portfolio-chat.js": {
      "maxDuration": 45
    }
  },
  "rewrites": [
    {
      "source": "/services",
      "destination": "/index.html"
    },
    {
      "source": "/services/",
      "destination": "/index.html"
    },
    {
