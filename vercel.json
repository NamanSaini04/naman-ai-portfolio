      "destination": "/offerings/index.html"
    },
    {
      "source": "/projects/fraud-detection/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/projects/airline-delay/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/projects/:slug",
      "destination": "/index.html"
    }
  ]
